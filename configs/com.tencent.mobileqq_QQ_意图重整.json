{
  "version": "0.1.0",
  "configs": {
    "QQ-意图重整": [
      [
        "cond",
        [
          "开关-QQ意图重整",
          "QQ-意图重整-规则"
        ]
      ]
    ],
    "QQ-意图重整-规则": [
      {
        "match": {
          "metaInfo": {
            "extra": {
              "intent_uri": "^(?!.*S\\.groupuin=).*S\\.groupcode=(?<id>\\d+)",
              "notify_effect": "2"
            }
          }
        },
        "replace": {
          "metaInfo": {
            "extra": {
              "intent_uri": "mqqwpa://im/chat?chat_type=group&open_type=chat&uin=${id}",
              "notify_effect": "2"
            }
          }
        },
        "stop": false
      },
      {
        "match": {
          "metaInfo": {
            "extra": {
              "intent_uri": "(?!.*S\\.groupuin=).*S\\.fromuin=(?<id>\\d+)",
              "notify_effect": "2"
            }
          }
        },
        "replace": {
          "metaInfo": {
            "extra": {
              "intent_uri": "mqqwpa://im/chat?chat_type=c2c&open_type=chat&uin=${id}",
              "notify_effect": "2"
            }
          }
        },
        "stop": false
      }
    ]
  }
}
